{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-service": {
      "root": "ai-service",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "angular"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-production-f8dd65c4.up.railway.app/api/:path*"
    },
    {
      "source": "/v3/api-docs/:path*",
      "destination": "https://backend-production-f8dd65c4.up.railway.app/v3/api-docs/:path*"
    },
    {
      "source": "/swagger-ui/:path*",
      "destination": "https://backend-production-f8dd65c4.up.railway.app/swagger-ui/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
