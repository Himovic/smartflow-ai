# Copy to .env and replace every secret before deploying.
HTTP_PORT=8088
PUBLIC_URL=http://localhost:8088
DB_USERNAME=smartflow
DB_PASSWORD=change-me-strong-db-password
# At least 32 random characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-please-use-openssl-rand-base64-48-characters
ENCRYPTION_KEY=change-me-another-long-random-secret-for-credentials
# Public demonstration mode (fictional Atlas Industries Group dataset + demo accounts).
# Set to false for production tenants. The demo is reset nightly at 03:00 (Africa/Algiers).
DEMO_ENABLED=true
DEMO_RESET_CRON=0 0 3 * * *
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
