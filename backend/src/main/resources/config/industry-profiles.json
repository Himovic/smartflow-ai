   "code": "QC-INCOMING",
   "name": "Incoming raw material inspection",
   "domain": "QUALITY",
   "inspectionType": "INCOMING",
   "description": "Reception control of raw materials and packaging (ISO 9001 §8.4).",
   "passingScore": 85,
   "questions": [
    {
     "id": "q1",
     "text": "Delivery note and certificate of analysis (CoA) present and matching the order",
