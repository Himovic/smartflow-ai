     "required": true,
     "weight": 1
    },
    {
     "id": "q2",
     "text": "Packaging intact, clean and correctly labelled (lot, expiry)",
     "type": "YES_NO",
     "required": true,
     "weight": 1,
     "critical": true
    },
    {
     "id": "q3",
     "text": "Transport vehicle clean, dry and free of pests",
     "type": "YES_NO",
     "required": true,
     "weight": 1,
     "critical": true
    },
    {
     "id": "q4",
     "text": "Product temperature at reception (°C)",
     "type": "NUMERIC",
     "required": true,
     "weight": 1,
     "min": 0,
     "max": 25,
     "unit": "°C",
     "createNc": true
    },
    {
     "id": "q5",
     "text": "Moisture content (%)",
     "type": "NUMERIC",
     "required": true,
     "weight": 2,
     "min": 0,
     "max": 14.5,
     "unit": "%",
     "createNc": true
    },
    {
     "id": "q6",
     "text": "Visual aspect conforms to specification",
     "type": "PASS_FAIL",
     "required": true,
     "weight": 2,
     "createNc": true
    },
    {
     "id": "q7",
     "text": "Foreign bodies detected?",
     "type": "YES_NO",
     "required": true,
     "weight": 1,
     "expected": "NO",
     "critical": true
    },
    {
     "id": "q8",
     "text": "Describe the foreign body",
     "type": "TEXT",
     "required": false,
     "weight": 1,
     "condition": {
      "questionId": "q7",
      "equals": "YES"
     }
    },
    {
     "id": "q9",
     "text": "Photo of the lot label",
     "type": "PHOTO",
     "required": false,
     "weight": 1
    },
    {
     "id": "q10",
     "text": "Inspector signature",
     "type": "SIGNATURE",
     "required": true,
     "weight": 1
    }
   ]
  },
